{
  "name": "dsh-quota-usage",
  "version": "0.1.0",
  "private": true,
  "description": "在 DSH 侧边栏底部、用户名正上方显示 DeepSeek 账号剩余额度（充值余额 + 赠送余额）的全局小组件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "quota",
    "balance",
    "usage",
    "额度",
    "余额"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ]
}
